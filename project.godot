config_version=5

[application]
config/name="The Thinking Gungeon"
config/icon="res://art/icon.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1200
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input]

move_left={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]
}
move_up={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]
}
move_down={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]
}
aim_left={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]
}
aim_right={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":4194323), Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]
}
aim_up={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]
}
aim_down={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]
}
fire={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventMouseButton,"button_index":1)]
}
leap={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":4194325,"location":1)]
}
toggle_planning={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":4194306), Object(InputEventJoypadButton,"button_index":3)]
}
pause_game={
"deadzone": 0.22,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
